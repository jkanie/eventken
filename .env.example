# Copy to .env and fill in. Every value here is empty on purpose.
# Load it into the shell before starting the server:
#   set -a && . ./.env && set +a

# PostgreSQL. compose.yaml starts 1 on localhost:5432 with user and password "eventken", for local work only.
EVENTKEN_DB_URL=
EVENTKEN_DB_USER=
EVENTKEN_DB_PASSWORD=

# At least 24 characters. Leave empty to turn the admin endpoints off.
EVENTKEN_ADMIN_TOKEN=

# true lets feeds use private, loopback, link-local, reserved addresses. For local work and tests only.
ALLOW_PRIVATE_TARGETS=

# Minutes between scheduled ingests (default 60, 0 turns it off).
EVENTKEN_INGEST_INTERVAL_MINUTES=
# Feeds fetched at the same time (default 4).
EVENTKEN_FETCH_CONCURRENCY=
# IANA zone for feed times that carry none (default UTC).
EVENTKEN_DEFAULT_TIME_ZONE=
EVENTKEN_HOST=
EVENTKEN_PORT=

# The server the desktop app talks to (default http://localhost:8080).
EVENTKEN_API_URL=
