<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older read this file when backup is on. allowBackup="false" turns it off,
     and this file excludes the saved events in case that ever changes. -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
