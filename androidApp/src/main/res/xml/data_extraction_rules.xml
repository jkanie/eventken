<?xml version="1.0" encoding="utf-8"?>
<!-- Saved events stay on the device: no cloud backup, no copy to a new device.
     Android 12 and later read this file. Older versions read allowBackup="false" and backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
